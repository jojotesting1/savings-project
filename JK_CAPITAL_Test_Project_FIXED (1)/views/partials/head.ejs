<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b1424"><meta name="description" content="JK CAPITAL — environnement de démonstration privé.">
  <title><%= title %> · JK CAPITAL</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/styles.css">
</head><body>
<div class="demo-strip"><span class="demo-dot"></span> ENVIRONNEMENT DE TEST · DONNÉES ET OPÉRATIONS FICTIVES · AUCUN PAIEMENT RÉEL</div>
<header class="topbar"><a class="brand" href="/"><span class="brand-mark">JK</span><span class="brand-copy"><strong>JK CAPITAL</strong><small>PRIVATE CLIENT PORTAL</small></span></a><nav class="topnav"><% if (currentUser) { %><span class="user-chip"><span class="avatar"><%= (currentUser.full_name || 'J').slice(0,1).toUpperCase() %></span><span><%= currentUser.full_name %></span></span><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-quiet btn-small" type="submit">Déconnexion</button></form><% } else { %><a class="nav-link" href="/login">Connexion</a><a class="btn btn-light btn-small" href="/register">Créer un compte</a><% } %></nav></header>
<% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
