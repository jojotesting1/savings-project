<%- include('partials/head', {title}) %>
<main class="app-shell admin-shell"><aside class="sidebar"><div class="side-label">ESPACE GESTION</div><a class="side-link active" href="/admin"><span>▦</span> Tableau de bord</a><a class="side-link" href="#deposits"><span>↓</span> Dépôts</a><a class="side-link" href="#withdrawals"><span>↑</span> Retraits</a><a class="side-link" href="#clients"><span>♙</span> Clients</a><a class="side-link" href="#ledger"><span>≡</span> Journal comptable</a><div class="sidebar-bottom"><div class="security-mark">✓</div><strong>Administration de test</strong><p>Chaque action est enregistrée et simulée.</p></div></aside><section class="app-content"><div class="page-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> CENTRE DE CONTRÔLE</div><h1>Administration</h1><p>Suivi des demandes et contrôle des comptes de test.</p></div><span class="pill-outline"><i class="dot dot-gold"></i> Admin</span></div><div class="stat-grid admin-stats"><article class="stat-card stat-primary"><div class="stat-top"><span>Clients inscrits</span><span class="stat-symbol">♙</span></div><div class="stat-value"><%= stats.clients %></div><div class="stat-foot">Comptes clients de test</div><div class="stat-watermark">♙</div></article><article class="stat-card"><div class="stat-top"><span>Dépôts à traiter</span><span class="stat-symbol">↓</span></div><div class="stat-value"><%= stats.pending_deposits %></div><div class="stat-foot">Demandes en attente</div></article><article class="stat-card"><div class="stat-top"><span>Retraits à traiter</span><span class="stat-symbol">↑</span></div><div class="stat-value"><%= stats.pending_withdrawals %></div><div class="stat-foot">Aucun virement réel</div></article><article class="stat-card"><div class="stat-top"><span>Total du journal</span><span class="stat-symbol">€</span></div><div class="stat-value stat-value-small"><%= formatMoney(stats.ledger_total) %></div><div class="stat-foot">Solde net fictif de tous les comptes</div></article></div><% if (demoMode) { %><section class="surface-card demo-action"><div><span class="panel-kicker">OUTIL DE SIMULATION</span><h2>Simuler une écriture quotidienne</h2><p>Ajoute un crédit fictif de 1 % au solde de chaque client. Ce bouton ne crée aucun rendement réel et ne doit pas être activé dans un environnement public.</p></div><form method="post" action="/admin/demo-daily-credit" onsubmit="return confirm('Ajouter un crédit fictif de 1 % à chaque client de test ?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-gold" type="submit">Exécuter la simulation <span>→</span></button></form></section><% } %>
<section class="surface-card admin-section" id="deposits"><div class="section-heading"><div><h2>Demandes de dépôt</h2><p>Approuver ou rejeter une demande fictive.</p></div><span class="count-pill"><%= deposits.filter(d=>d.status==='pending').length %> en attente</span></div><div class="table-wrap"><table><thead><tr><th>Client</th><th>Référence</th><th>Date</th><th>Montant</th><th>Statut</th><th>Action</th></tr></thead><tbody><% if (!deposits.length) { %><tr><td colspan="6" class="empty-cell">Aucune demande.</td></tr><% } %><% deposits.forEach(d=>{ %><tr><td><strong><%= d.full_name %></strong><small class="table-sub"><%= d.email %></small></td><td>#DEP-<%= d.id %></td><td><%= formatDate(d.created_at) %></td><td><strong><%= formatMoney(d.amount) %></strong></td><td><span class="status status-<%= d.status %>"><%= ({pending:'En attente',approved:'Approuvé (test)',rejected:'Rejeté'})[d.status] %></span></td><td><% if(d.status==='pending'){ %><div class="action-pair"><form method="post" action="/admin/deposits/<%= d.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-mini btn-approve" type="submit">Valider</button></form><form method="post" action="/admin/deposits/<%= d.id %>/reject"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-mini btn-reject" type="submit">Rejeter</button></form></div><% } else { %><span class="muted">Terminé</span><% } %></td></tr><% }) %></tbody></table></div></section>
<section class="surface-card admin-section" id="withdrawals"><div class="section-heading"><div><h2>Demandes de retrait</h2><p>Marquage « payé » simulé, avec référence fictive obligatoire.</p></div><span class="count-pill"><%= withdrawals.filter(w=>w.status==='pending').length %> en attente</span></div><div class="table-wrap"><table><thead><tr><th>Client</th><th>Référence</th><th>Date</th><th>Montant</th><th>Statut</th><th>Action</th></tr></thead><tbody><% if (!withdrawals.length) { %><tr><td colspan="6" class="empty-cell">Aucune demande.</td></tr><% } %><% withdrawals.forEach(w=>{ %><tr><td><strong><%= w.full_name %></strong><small class="table-sub"><%= w.email %></small></td><td>#RET-<%= w.id %></td><td><%= formatDate(w.created_at) %></td><td><strong><%= formatMoney(w.amount) %></strong></td><td><span class="status status-<%= w.status %>"><%= ({pending:'En attente',paid:'Payé (simulation)',rejected:'Rejeté'})[w.status] %></span></td><td><% if(w.status==='pending'){ %><form method="post" action="/admin/withdrawals/<%= w.id %>/paid" class="pay-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="text" name="reference" placeholder="Réf. fictive" aria-label="Référence fictive" minlength="3" maxlength="120" required><button class="btn btn-mini btn-approve" type="submit">Marquer payé</button></form><form method="post" action="/admin/withdrawals/<%= w.id %>/reject" class="reject-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-mini btn-reject" type="submit">Rejeter</button></form><% } else { %><span class="muted"><%= w.payout_reference || 'Terminé' %></span><% } %></td></tr><% }) %></tbody></table></div></section>
<section class="surface-card admin-section" id="clients"><div class="section-heading"><div><h2>Comptes clients</h2><p>Soldes calculés depuis le journal d’écritures.</p></div><span class="count-pill"><%= clients.length %> affichés</span></div><div class="table-wrap"><table><thead><tr><th>Client</th><th>Créé le</th><th>Solde fictif</th><th>Retrait réservé</th><th>Ajustement de test</th></tr></thead><tbody><% if (!clients.length) { %><tr><td colspan="5" class="empty-cell">Aucun client.</td></tr><% } %><% clients.forEach(c=>{ %><tr><td><strong><%= c.full_name %></strong><small class="table-sub"><%= c.email %></small></td><td><%= formatDate(c.created_at) %></td><td><strong><%= formatMoney(c.balance) %></strong></td><td><%= formatMoney(c.reserved) %></td><td><form method="post" action="/admin/clients/<%= c.id %>/adjust" class="adjust-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="direction" aria-label="Sens de l’ajustement"><option value="credit">Crédit +</option><option value="debit">Débit −</option></select><input type="number" name="amount" min="0.01" max="1000000" step="0.01" placeholder="Montant" required><input type="text" name="reason" placeholder="Motif obligatoire" minlength="5" maxlength="200" required><button class="btn btn-mini btn-dark" type="submit">Enregistrer</button></form></td></tr><% }) %></tbody></table></div></section>
<section class="surface-card admin-section" id="ledger"><div class="section-heading"><div><h2>Journal comptable</h2><p>Historique append-only des crédits et débits de test.</p></div></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Client</th><th>Date</th><th>Type</th><th>Description</th><th>Montant</th></tr></thead><tbody><% if (!ledger.length) { %><tr><td colspan="6" class="empty-cell">Aucune écriture.</td></tr><% } %><% ledger.forEach(l=>{ %><tr><td>#<%= l.id %></td><td><strong><%= l.full_name %></strong><small class="table-sub"><%= l.email %></small></td><td><%= formatDate(l.created_at) %></td><td><span class="type-chip"><%= l.entry_type %></span></td><td><%= l.description %></td><td class="<%= Number(l.amount)<0?'negative':'positive' %>"><%= Number(l.amount)>0?'+':'' %><%= formatMoney(l.amount) %></td></tr><% }) %></tbody></table></div></section><div class="notice-bar"><span>ⓘ</span><p><strong>Mode de test uniquement.</strong> La validation d’un dépôt ajoute un crédit fictif. « Marquer payé » ne déclenche aucun virement bancaire. Ne connecte pas de compte bancaire ou de prestataire de paiement à cette version.</p></div></section></main><%- include('partials/foot') %>
